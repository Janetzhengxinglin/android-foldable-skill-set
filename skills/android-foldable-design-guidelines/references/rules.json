  "rules": [
    {
      "id": "window.fit",
      "category_id": "window",
      "title": "填满实际窗口，内容不越界",
      "priority": 1,
      "subject_type": "page",
      "component_kinds": [],
      "conditions": {},
      "evidence_groups": [
        [
          "image"
        ]
      ],
      "basis_ids": [
        "S03.Config_Changes",
        "S03.T-Config_Orientation",
        "S04.Fullscreen_Display"
      ],
      "test_ids": [
        "T-Config_Orientation"
      ],
      "requirement_wording": "official_basic_requirement",
      "applies_when": "全部 App 页面；全屏与分屏分别按实际 App 窗口检查。",
      "do_not_report": "正文、表单、按钮等局部内容可合理限宽；单栏或留白本身不能单独证明违规。此例外不能用于排除整个页面主体未随窗口适配：须分别核对 App 窗口、整页根容器和局部内容。App 未填满实际可用显示区或存在整体加框时按本条报告；背景、正文和固定操作整体局限窄区而其余区域大面积空白时，核查整页边界，证据不足保留基础适配疑点，不能直接判通过。媒体等比留边不等于 App 整体加框；不从单张截图推断兼容模式或固定宽度代码。分屏按实际 App 窗口判断。",
      "lifecycle": "verified",
      "supporting_source_ids": [
        "S05",
        "S06",
        "S21",
        "S22",
        "S16",
        "S68",
        "S50",
        "S51"
      ],
      "profiles": [
        "screenshot-only",
        "submitted-evidence"
      ]
    },
